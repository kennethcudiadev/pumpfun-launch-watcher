# --- Required ---
# Helius API key. Get one free at https://helius.dev
HELIUS_API_KEY=your_helius_api_key_here

# --- Optional (sensible defaults shown) ---

# RPC HTTP endpoint used for getTransaction / getAccountInfo lookups.
# Defaults to Helius mainnet RPC built from HELIUS_API_KEY.
# RPC_HTTP_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# WebSocket endpoint for log subscription.
# Defaults to Helius standard WS built from HELIUS_API_KEY.
# Use Atlas (Geyser) endpoint for paid plans:
#   wss://atlas-mainnet.helius-rpc.com/?api-key=YOUR_KEY
# WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Pump.fun program ID (mainnet)
PUMPFUN_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P

# JSONL log file path
LOG_FILE=./launches.jsonl

# Tracking window (seconds) after a launch
TRACKING_WINDOW_SECONDS=120

# Bonding curve sample checkpoints, in seconds, comma-separated
TRACKING_CHECKPOINTS=30,60,120

# Max creators kept in the in-memory LRU cache
MAX_CREATORS_CACHED=10000

# Recent-launches table size in the dashboard
DASHBOARD_RECENT_ROWS=10

# Dashboard refresh interval (ms)
DASHBOARD_REFRESH_MS=1000

# Set to "true" to disable the live dashboard and emit plain log lines only
HEADLESS=false
