{
  "name": "pumpfun-launch-watcher",
  "version": "0.1.0",
  "description": "Real-time pump.fun token launch monitor for Solana — tracks new launches, creator history, bonding curve velocity, and first-buyer flow. Open data feed for Solana trading bots.",
  "keywords": [
    "solana",
    "pumpfun",
    "pump.fun",
    "trading-bot",
    "memecoin",
    "mev",
    "jito",
    "helius",
    "geyser",
    "bonding-curve",
    "sniper-bot",
    "defi",
    "websocket",
    "real-time"
  ],
  "main": "dist/index.js",
  "bin": {
    "pumpfun-watch": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/pumpfun-launch-watcher"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.3",
    "bs58": "^6.0.0",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "dotenv": "^16.4.5",
    "lru-cache": "^11.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "rimraf": "^5.0.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
